{
  "enabledPlugins": {
    "workflow@skills-dir": true,
    "workflow@inline": false
  },
  "autoMemoryEnabled": false,
  "autoCompactWindow": 200000,
  "permissions": {
    "deny": [
      "Edit(memory/**)",
      "Edit(decisions/**)",
      "Edit(rules/**)",
      "Edit(skills/**)",
      "Edit(topics/**)",
      "Edit(exceptions/**)",
      "Edit(logs/**)",
      "Edit(policy.json)",
      "Edit(.githooks/**)",
      "Edit(.gitattributes)",
      "Edit(.gitignore)",
      "Edit(.workflow.json)",
      "Edit(README.md)",
      "Edit(~/.claude/**)",
      "Edit(.claude/skills/**)"
    ],
    "ask": [
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git branch -D)",
      "Bash(git branch -D *)",
      "Bash(git branch -d)",
      "Bash(git branch -d *)",
      "Bash(git stash drop)",
      "Bash(git stash drop *)",
      "Bash(git checkout --)",
      "Bash(git checkout -- *)",
      "Bash(git rebase -i)",
      "Bash(git rebase -i *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  }
}
